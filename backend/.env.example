# Copy this file to .env and fill in your key.

# Used for everything: concept explanations, quiz generation, relevance
# judging, hints, the tutor conversation, embeddings, and video/audio
# transcription. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Coaches sign in with Google. Create these in Google Cloud Console -- see
# README "Google Cloud Console setup" for the exact steps (OAuth consent
# screen + OAuth client ID, both under APIs & Services).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs the temporary cookie used only during the Google login handshake
# (unrelated to the actual coach-session cookie). Any random string works --
# generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# The origin your browser actually addresses. Leave as-is for local dev
# (matches `npm run dev`'s default port); set to your Render URL in
# production. Must exactly match a redirect URI registered in Google Cloud
# Console (as `<this>/api/auth/google/callback`).
PUBLIC_BASE_URL=http://localhost:5173

# The very first coach account bootstraps itself on first Google sign-in --
# no invite needed. After that, invite each teammate by email from the home
# page (Coach/CoachSession in app/models.py).

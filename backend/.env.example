# Copy this file to .env and fill in your key.

# Used for everything: concept explanations, quiz generation, relevance
# judging, hints, the tutor conversation, embeddings, and video/audio
# transcription. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Shared password gating the whole app once it's deployed for the other
# coaches to use. Leave empty for local dev (no gate). Set this as a secret
# in your hosting platform's dashboard for the real deployment -- never
# commit an actual value here.
COACH_PASSWORD=

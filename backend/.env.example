# Copy this file to .env and fill in your keys.

# Used for all generation/reasoning: concept explanations, quiz generation,
# relevance judging, hints, and the tutor conversation.
ANTHROPIC_API_KEY=

# Used only for embeddings (text-embedding-3-small) and Whisper transcription
# of uploaded video/audio resources. Anthropic has no embeddings API, so a
# second provider is needed for that piece.
OPENAI_API_KEY=

# Optional overrides
# claude-sonnet-5 is the default here for cost (this app makes many small,
# latency-sensitive calls); bump to claude-opus-4-8 if you want higher quality.
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TRANSCRIBE_MODEL=whisper-1
